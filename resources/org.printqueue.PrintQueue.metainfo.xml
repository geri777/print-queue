      <image type="source" width="1078" height="738">https://raw.githubusercontent.com/geri777/print-queue/main/resources/screenshot.png</image>
      <caption>PrintQueue main window</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/geri777/print-queue/</url>
  <url type="bugtracker">https://github.com/geri777/print-queue/issues</url>

  <releases>
