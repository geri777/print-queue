[Desktop Entry]
Type=Application
Name=PrintQueue
Comment=Dokumente sammeln und gemeinsam drucken
Exec=printqueue %F
Icon=printer
Terminal=false
Categories=Office;Utility;
MimeType=application/pdf;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.presentationml.presentation;image/png;image/jpeg;image/tiff;

